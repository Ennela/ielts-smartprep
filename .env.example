# ===== SPRING PROFILE =====
# Activate a profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# ===== DATABASE =====
# MYSQL_HOST and MYSQL_PORT are used by local Python maintenance scripts.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_DATABASE=ielts_smartprep
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ielts_smartprep
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace_with_local_root_password

# ===== JWT (REQUIRED — app will NOT start without this) =====
# Generate a strong random secret (min 32 characters / 256 bits):
#   openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_value_at_least_32_bytes

# ===== GOOGLE GEMINI AI =====
GEMINI_API_KEY=replace_with_a_rotated_api_key
# Optional alternative for scripts/import_cambridge.py. Leave empty unless used.
OPENROUTER_API_KEY=

# ===== FRONTEND =====
VITE_API_URL=http://localhost:8080/api/v1
FRONTEND_URL=http://localhost:5173

# ===== CORS =====
# Comma-separated list of allowed origins. For production, set to your actual domain(s).
# Example: CORS_ALLOWED_ORIGINS=https://smartprep.example.com
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000

# ===== SECURITY =====
# Set to false in production to disable Swagger UI
SWAGGER_ENABLED=true
# Local HTTP development uses false; the prod Spring profile forces secure cookies.
SECURE_COOKIES=false

# ===== MINIO (S3-compatible Storage) =====
MINIO_ACCESS_KEY=replace_with_a_local_minio_username
MINIO_SECRET_KEY=replace_with_a_local_minio_password
MINIO_BUCKET=listening-audio

# ===== EDGE TTS =====
TTS_ENABLED=true
EDGE_TTS_URL=http://localhost:8000
# Edge TTS API hardening (comma-separated values where applicable)
EDGE_TTS_CORS_ALLOWED_ORIGINS=http://localhost:5173
EDGE_TTS_ALLOWED_VOICES=en-US-GuyNeural,en-US-AriaNeural,en-GB-RyanNeural,en-GB-SoniaNeural,en-AU-WilliamNeural,en-AU-NatashaNeural
EDGE_TTS_MAX_TEXT_LENGTH=5000
EDGE_TTS_MAX_REQUEST_BYTES=20000
EDGE_TTS_RATE_LIMIT_REQUESTS=30
EDGE_TTS_RATE_LIMIT_WINDOW_SECONDS=60

# ===== MAIL (Gmail App Password) =====
# Create an App Password at https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=replace_with_a_mail_app_password

# ===== SENTRY (Error Tracking — Free Tier) =====
# Get your DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
VITE_SENTRY_DSN=
