# Production environment for docker-compose.prod.yml.
#
# Copy to .env.prod on the server and fill in. Never commit the filled-in file --
# .gitignore covers .env.* and this template is the only exception.
#
# Verify before deploying:
#   python scripts/check_env.py --example .env.prod.example --env .env.prod
#
# Every value below that has no default is enforced by docker-compose.prod.yml: compose
# refuses to start and names the variable rather than booting a half-configured stack.

# ===== SITE =====
# The hostname this stack serves. Must already resolve to this server, and ports 80 and
# 443 must be reachable, or Caddy cannot complete the ACME challenge and no certificate
# is issued. Use localhost to try the stack out with Caddy's internal CA instead.
APP_DOMAIN=smartprep.example.com
# Where Let's Encrypt sends certificate expiry warnings.
ACME_EMAIL=ops@example.com

# ===== IMAGES =====
# Published by the CI workflow. Lowercase -- GHCR rejects uppercase paths.
IMAGE_REGISTRY=ghcr.io/ennela/ielts-smartprep
# The commit SHA to run. scripts/deploy.sh sets this; it is listed here only so the file
# documents it. Do not pin this to `latest`: `latest` cannot answer "what is running?",
# which is the question a rollback starts from.
IMAGE_TAG=

# ===== DATABASE =====
MYSQL_DATABASE=ielts_smartprep
MYSQL_ROOT_PASSWORD=generate_a_long_random_value
# Must NOT be root: the MySQL image refuses MYSQL_USER=root and aborts initialisation.
SPRING_DATASOURCE_USERNAME=smartprep
# A different value from MYSQL_ROOT_PASSWORD. These are two separate accounts.
SPRING_DATASOURCE_PASSWORD=generate_a_long_random_value

# ===== REDIS =====
# Used twice: as redis-server --requirepass, and as the credential both backend Redis
# clients authenticate with. One value, so they cannot drift apart.
REDIS_PASSWORD=generate_a_long_random_value

# ===== JWT =====
# At least 32 bytes, or the application refuses to start:
#   openssl rand -base64 48
JWT_SECRET=generate_a_long_random_value_at_least_32_bytes

# ===== GOOGLE GEMINI AI =====
GEMINI_API_KEY=your_gemini_api_key

# ===== MINIO =====
MINIO_ACCESS_KEY=generate_a_long_random_value
MINIO_SECRET_KEY=generate_a_long_random_value
MINIO_BUCKET=listening-audio

# ===== EDGE TTS =====
TTS_ENABLED=true
# Empty on purpose. Only the backend calls this service, server side over the internal
# network, so no browser origin needs allowing.
EDGE_TTS_CORS_ALLOWED_ORIGINS=
EDGE_TTS_ALLOWED_VOICES=en-US-GuyNeural,en-US-AriaNeural,en-GB-RyanNeural,en-GB-SoniaNeural,en-AU-WilliamNeural,en-AU-NatashaNeural
EDGE_TTS_MAX_TEXT_LENGTH=5000
EDGE_TTS_MAX_REQUEST_BYTES=20000
EDGE_TTS_RATE_LIMIT_REQUESTS=30
EDGE_TTS_RATE_LIMIT_WINDOW_SECONDS=60

# ===== MAIL (Gmail App Password) =====
# Leaving both blank runs the stack without email: account verification and password reset
# stop working, nothing else does, and the container health check still passes.
#
# One visible side effect if you do. Spring registers a mail health indicator that dials
# smtp.gmail.com, and it has no idea mail is optional here -- so /actuator/health returns
# 503 permanently even though the application is fine. Nothing in the stack gates on that
# endpoint (the containers probe /actuator/health/liveness, and scripts/deploy.sh checks
# the readiness group), but point an uptime monitor at it and it will cry wolf. To silence
# it, add to backend/src/main/resources/application-prod.yml:
#     management:
#       health:
#         mail:
#           enabled: false
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== SENTRY =====
# Backend DSN, read at runtime.
SENTRY_DSN=
# The frontend DSN is NOT read here. Vite inlines it at build time, so it is a build
# argument in the CI workflow, supplied by the VITE_SENTRY_DSN repository secret. Setting
# it in this file would have no effect.

# ===== NOT USED IN PRODUCTION =====
# CORS_ALLOWED_ORIGINS and FRONTEND_URL are derived from APP_DOMAIN by
# docker-compose.prod.yml, so that a domain change cannot leave them pointing elsewhere.
# SPRING_PROFILES_ACTIVE is hardcoded to prod there for the same reason.
